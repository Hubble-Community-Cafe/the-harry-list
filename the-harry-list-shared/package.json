{
  "name": "the-harry-list-shared",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Shared by the public form and the admin: layout-independent components and helpers, the self-hosted fonts and skip-link styles, the nginx config, and the base TypeScript, ESLint, Vite and Vitest configs. Consumed as TypeScript source (no build step).",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styles.css",
    "./tsconfig.app.base.json": "./tsconfig.app.base.json",
    "./tsconfig.node.base.json": "./tsconfig.node.base.json",
    "./eslint.config.base.js": "./eslint.config.base.js",
    "./vite.config.base.js": {
      "types": "./vite.config.base.d.ts",
      "default": "./vite.config.base.js"
    },
    "./vitest.config.base.js": {
      "types": "./vitest.config.base.d.ts",
      "default": "./vitest.config.base.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.2",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  }
}
